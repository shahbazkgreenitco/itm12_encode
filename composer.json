{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.263",
        "binarytorch/larecipe": "^2.6",
        "doctrine/dbal": "^3.7",
        "dompdf/dompdf": "*",
        "dragonmantank/cron-expression": "^3.3",
        "google/apiclient": "^2.15",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^3.11",
        "intervention/image-laravel": "^1.5",
        "jenssegers/agent": "^2.6",
        "kreait/laravel-firebase": "^6.2",
        "laravel/framework": "^12.45",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.6",
        "league/commonmark": "^2.4",
        "maatwebsite/excel": "^3.1.52",
        "mistic100/randomcolor": "^1.0",
        "niklasravnsborg/laravel-pdf": "^4.1",
        "paperdoc-dev/paperdoc-lib": "^0.8.3",
        "phpoffice/phpspreadsheet": "^1.30",
        "predis/predis": "^2.2",
        "rap2hpoutre/fast-excel": "^5.0",
        "socialiteproviders/microsoft": "^4.9",
        "socialiteproviders/microsoft-azure": "^5.2",
        "spatie/laravel-littlegatekeeper": "^2.0",
        "spatie/laravel-pdf": "^2.11",
        "spatie/laravel-permission": "^6.0",
        "tecnickcom/tc-lib-barcode": "^1.18",
        "twilio/sdk": "^8.4",
        "webklex/laravel-imap": "^2.4.0",
        "yooper/php-text-analysis": "^1.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/dusk": "^8.0",
        "laravel/pail": "^1.2",
        "laravel/sail": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
